{
  "permissions": {
    "allow": [
      "Bash(npx supabase link*)",
      "Bash(npx supabase projects api-keys*)",
      "Bash(git fetch*)",
      "Bash(npx supabase migration list*)",
      "Bash(npx vercel alias*)",
      "Bash(npx tsc*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__claude_ai_Supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-production.mjs\""
          }
        ]
      }
    ]
  }
}
