{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://connectioncyber.local/contracts/device-envelope-v1.json","title":"ConnectionCyber Device Envelope v1","type":"object","additionalProperties":false,"required":["protocolVersion","messageId","tenantId","establishmentId","agentId","type","issuedAt","expiresAt","nonce","idempotencyKey","keyId","payload","signature"],"properties":{"protocolVersion":{"const":"1.0"},"messageId":{"type":"string","format":"uuid"},"tenantId":{"type":"string","format":"uuid"},"establishmentId":{"type":"string","format":"uuid"},"agentId":{"type":"string","format":"uuid"},"type":{"enum":["agent.heartbeat","device.inventory","print.execute","scale.read","cash_drawer.open","tef.execute","offline.snapshot.ack","offline.operation.push","command.result"]},"issuedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{22,128}$"},"idempotencyKey":{"type":"string","minLength":8,"maxLength":200},"keyId":{"type":"string","minLength":8,"maxLength":100},"payload":{"type":"object"},"signature":{"type":"string","minLength":80,"maxLength":128}}}
