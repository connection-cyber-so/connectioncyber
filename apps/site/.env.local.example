# =========================================================
# ConnectionCyber — Variáveis de Ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA cometa o .env.local real no controle de versão.
# =========================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Mercado Pago ---
# Kill switch: use true SOMENTE no ambiente Production da Vercel.
PAYMENTS_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- n8n (automação) ---
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.connectioncyber.com.br
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# --- Segurança ---
# Valor aleatório longo, diferente por ambiente; usado apenas no servidor.
RATE_LIMIT_SALT=

# --- Ngrok (apenas desenvolvimento local) ---
NGROK_AUTH_TOKEN=
