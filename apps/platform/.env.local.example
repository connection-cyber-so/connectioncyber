# =========================================================
# ConnectionCyberSO — Painel Interno — Variáveis de Ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA cometa o .env.local real no controle de versão.
#
# Convenção do projeto: local (.env.local) SEMPRE aponta para o Supabase
# de staging (ozvylnaipubrmaadikvk), nunca para produção
# (qfggetvashdxyuvlhihq) — ver README.md raiz do monorepo.
# =========================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Painel ---
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3011

# --- Persistência visual (somente servidor) ---
# Valores aceitos: synthetic | persistent-read-only | persistent
# 'persistent' grava de verdade no Supabase (M21-G1, Trilha A) — autorização explícita
# do usuário, nunca o padrão. O padrão deste arquivo continua 'synthetic'; mudar pra
# 'persistent' em produção/staging real é decisão de quem faz o deploy, não deste código.
SERVER_VISUAL_PERSISTENCE_MODE=synthetic
